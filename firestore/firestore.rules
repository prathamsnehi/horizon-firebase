rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin allowlist. Membership is simply the existence of a document at
    // admins/{uid} — add or remove one to grant or revoke access instantly,
    // with no deploy and no custom claims to refresh.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A signed-in user may check their OWN admin record and nothing else, so
    // the dashboard can tell "not allowlisted" from "request failed" without
    // exposing who the admins are.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // granted by hand in the console
    }

    // The anonymous observability corpus, read-only, admins only. Written by
    // the backend through the Admin SDK, which bypasses these rules entirely.
    match /generation_samples/{sampleId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Everything else stays closed to clients: user_rate_limits, pregen_cache,
    // llm_rate_buckets and logs are server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
