# Template for `functions/.env` — copy this file to `.env` and fill in values.
#
#   cp functions/.env.example functions/.env
#
# `.env` is gitignored; this template is committed. Firebase loads `.env` at
# deploy time and binds the values to the `firebase-functions/params`
# declarations in `src/config.ts`. Every param has a safe default, so a missing
# `.env` yields ordinary production behaviour rather than an error.
#
# Note: API keys do NOT belong here. Provider and Maps keys are `defineSecret`
# params stored in Google Cloud Secret Manager.

# ---------------------------------------------------------------------------
# RATE_LIMIT_EXEMPT_UIDS  (list, comma-separated, default: empty)
# ---------------------------------------------------------------------------
# Firebase Auth uids exempt from the per-user 24h generation limit — developer
# accounts that need to generate freely while testing. Leave empty to gate every
# user normally.
#
# Find your uid: Firebase console -> Authentication -> Users -> User UID.
#
# Safe to leave configured in production: `request.auth.uid` comes from a signed
# Auth token, so only the account owner can present it, and total spend stays
# bounded by the Maps daily quotas and the per-provider LLM rate windows.
#
# Example (single):    RATE_LIMIT_EXEMPT_UIDS=abc123
# Example (multiple):  RATE_LIMIT_EXEMPT_UIDS=abc123,def456
RATE_LIMIT_EXEMPT_UIDS=
